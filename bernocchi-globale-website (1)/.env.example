# Public canonical origin (not a secret)
NEXT_PUBLIC_SITE_URL=https://bernocchiglobale.it

# Server-only Google Calendar integration. Configure real values in Netlify UI.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=America/Costa_Rica

# Server-only, high-entropy secret used to sign expiring administrative links.
BOOKING_ADMIN_SECRET=

# Server-only transactional email configuration.
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=
