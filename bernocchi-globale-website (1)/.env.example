# Public origin
NEXT_PUBLIC_SITE_URL=https://bernocchiglobale.it

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email (server only)
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=segreteria@bernocchiglobale.it
CONTACT_FROM_EMAIL=

# Casa Bernocchi Calendar Core (server only).
# GOOGLE_CALENDAR_ID is the safe fallback used while a dedicated calendar has not
# yet been assigned to a scope. GOOGLE_CALENDAR_MAP_JSON can later route each Ordo
# or operational alias to a different Google Calendar without changing code.
GOOGLE_CALENDAR_ID=segreteria@bernocchiglobale.it
GOOGLE_CALENDAR_MAP_JSON={"casa_bernocchi":"segreteria@bernocchiglobale.it","general_secretariat":"segreteria@bernocchiglobale.it","segreteria_generale":"segreteria@bernocchiglobale.it","office_of_founder":"segreteria@bernocchiglobale.it","health":"segreteria@bernocchiglobale.it","legal":"segreteria@bernocchiglobale.it","technology":"segreteria@bernocchiglobale.it","business_services":"segreteria@bernocchiglobale.it","ordo_medicinae":"segreteria@bernocchiglobale.it","ordo_iuris":"segreteria@bernocchiglobale.it","ordo_scientia":"segreteria@bernocchiglobale.it","ordo_capitalis":"segreteria@bernocchiglobale.it","ordo_innovatio":"segreteria@bernocchiglobale.it","ordo_humanitatis":"segreteria@bernocchiglobale.it"}
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Payment orchestration. Keep disabled until at least one provider has passed
# sandbox and live acceptance testing on the merchant-owned account.
PAYMENTS_ENABLED=false

# PayPal Checkout
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ONVO one-time Checkout links (Costa Rica). Each service must have an explicit
# USD or CRC amount; no automatic FX conversion is performed.
ONVO_SECRET_KEY=
ONVO_WEBHOOK_SECRET=
ONVO_PRICE_MAP_JSON={}

# Advertise wallets only after the merchant contract and production test prove
# eligibility. Comma-separated: apple_pay,google_pay
PAYMENT_WALLETS=

# Optional analytics integrations; all require visitor consent.
ANALYTICS_SALT=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
